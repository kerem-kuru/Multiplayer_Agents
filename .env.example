# Postgres — docker compose ile ayaga kalkar
DATABASE_URL=postgres://rooms:Kk2007..@localhost:5433/agent_rooms

# Redis — Faz 2'de pub/sub icin
REDIS_URL=redis://localhost:6380

# API
PORT=8787

# Oda container'lari
ROOM_IMAGE=agent-rooms/room:dev
ROOM_DATA_DIR=./rooms-data

# Anahtar — Hafta 2'de Agent SDK icin gerekecek (BYOK)
ANTHROPIC_API_KEY=

# Rol YAML'i — POST /rooms govdesinde configPath ile ezilebilir
ROOM_CONFIG=./config/room.example.yaml

# 0 = container acma (docker'siz gelistirme)
SPAWN_CONTAINER=1

# --- Hafta 2: agent kosumu ---
# Anahtar SADECE burada yasar; imaja ve compose'a gomulmez.
ANTHROPIC_API_KEY=
# YAML'daki model'i ezer. Bos birakilirsa rol YAML'i gecerli.
# DIKKAT: bu deger IKI kosum ortamina da gider. Odada hem Claude hem Gemini
# agent'i varsa kosum ortamina ozel olanlari kullan — asagidakiler bunu ezer.
AGENT_MODEL=
AGENT_MODEL_CLAUDE=
AGENT_MODEL_GEMINI=
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=1.00
AGENT_HEARTBEAT_TIMEOUT_MS=20000

# --- Saglayici secimi (istege bagli) ---
# Ayni Claude modelleri, farkli arka uc. Birini "1" yap ve o saglayicinin
# kimlik degiskenlerini tanimla; ANTHROPIC_API_KEY o zaman gerekmez.
#   CLAUDE_CODE_USE_BEDROCK=1   + AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   CLAUDE_CODE_USE_VERTEX=1    + ANTHROPIC_VERTEX_PROJECT_ID, GOOGLE_APPLICATION_CREDENTIALS
#   ANTHROPIC_BASE_URL=...      + ANTHROPIC_AUTH_TOKEN   (kurumsal gateway)
# AWS_* ve GOOGLE_* degiskenleri container'a OLDUGU GIBI gecer.

# --- Hafta 4: giris, davet ve redaction ---
# Magic link ve davet linklerinin govdesi. Arayuz nerede calisiyorsa orasi;
# tunelle disariya acarken bu adres degisir.
APP_BASE_URL=http://localhost:5173
# SADECE GELISTIRME: e-posta gonderimi olmadigi icin giris baglantisini
# yanitta ve logda goster. YETKILENDIRMEYI ETKILEMEZ — acikken de her uc
# uyelik ve rol kontrolu yapar. Uretimde bos birak.
AUTH_DEV_MODE=true
# HTTPS ardindaysan true; cerez Secure bayragi alir.
COOKIE_SECURE=false
