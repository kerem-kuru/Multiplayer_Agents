{
  "name": "agent-rooms",
  "private": true,
  "version": "0.0.1",
  "description": "Multiplayer Agent Odalari — bir odada birden cok agent, birden cok gelistirici, tek paylasilan baglam",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/protocol packages/redact packages/gitkit packages/core apps/api && tsc -p packages/runner && tsc -p packages/runner-gemini",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:gemini": "node scripts/smoke-gemini.mjs",
    "gate": "bash scripts/week1-gate.sh",
    "gate:w2": "bash scripts/week2-gate.sh",
    "gate:w3": "bash scripts/week3-gate.sh",
    "gate:w3:agent": "npm run test:e2e -w @agent-rooms/web",
    "gate:w4": "bash scripts/week4-gate.sh",
    "gate:w4:agent": "bash scripts/week4-agent-gate.sh",
    "api": "node apps/api/dist/index.js",
    "api:dev": "node --watch apps/api/dist/index.js",
    "dev:web": "npm run dev -w @agent-rooms/web",
    "dev:all": "npm run build && concurrently -n api,web -c cyan,magenta \"npm run api\" \"npm run dev:web\"",
    "room:build": "node scripts/build-runner.mjs && docker compose --profile build-only build room",
    "verify": "npm run build && node scripts/verify.mjs",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:reset": "docker compose down -v && docker compose up -d postgres redis",
    "runner:build": "node scripts/build-runner.mjs",
    "rules:import": "node scripts/import-gitleaks.mjs",
    "gate:w5": "bash scripts/week5-gate.sh",
    "gate:w5:agent": "bash scripts/week5-agent-gate.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.5",
    "smol-toml": "^1.8.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
